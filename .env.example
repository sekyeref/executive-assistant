APP_NAME="Executive Assistant"
DATABASE_URL="sqlite:///./assistant.db"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/auth/google/callback"
GOOGLE_SCOPES="https://www.googleapis.com/auth/calendar https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/gmail.readonly"

OPENAI_API_KEY=""

AUTONOMY_MODE="sandbox"
ALLOW_TEST_TRADING=true
ALLOW_LIVE_TRADING=false
REQUIRE_MANUAL_CONFIRMATION=true
MAX_TRADE_VALUE=1000.0

BROKER_PROVIDER="alpaca"
ALPACA_API_KEY=""
ALPACA_SECRET_KEY=""
ALPACA_BASE_URL="https://paper-api.alpaca.markets"
ALPACA_PAPER_MODE=true

ENABLE_LIVE_EXECUTION=false
REQUIRE_APPROVAL_FOR_LIVE=true
ENABLE_REAL_BROKER=false
